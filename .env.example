# Database Configuration (SQLite for dev; switch to postgresql:// or mysql+pymysql:// for production)
DATABASE_URL=sqlite:///./efootball_league.db

# JWT Security Configuration
JWT_SECRET_KEY=super-secret-efootball-2v2-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Credentials (created automatically on startup)
ADMIN_NAME=League Commissioner
ADMIN_EFOOTBALL_USERNAME=admin_efootball
ADMIN_PASSWORD=AdminPassword123!

